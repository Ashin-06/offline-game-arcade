{
  "manifest_version": 3,
  "name": "Offline Game Arcade",
  "version": "1.0",
  "description": "Play a collection of fun games when your internet is down.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "notifications" 
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  }
}